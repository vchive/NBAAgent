APP_ENV=local
PUBLIC_DATA_MODE=fixture
# Optional: keep the fixture demo populated on days without a real NBA game.
# Ignored when PUBLIC_DATA_MODE is live or hybrid.
HIGHLIGHTS_DEMO_DATE=2026-06-12
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_MAX_RETRIES=2
REQUEST_DEADLINE_MS=10000
QUEUE_WAIT_DEADLINE_MS=1000
MAX_PROVIDER_OPERATIONS=4
CACHE_TTL_LIVE_SECONDS=45
CACHE_TTL_BOXSCORE_SECONDS=300
CACHE_TTL_HISTORY_SECONDS=86400
SESSION_TTL_SECONDS=86400
MAX_SESSION_TURNS=8
MAX_SESSION_BYTES=16384
CACHE_MAX_ENTRIES=10000
LLM_MODE=mock
# Default is offline/mock. To opt in to the constrained SiliconFlow composer,
# set LLM_MODE=live, RUNTIME_PROFILE=hybrid (or hermes), and
# HERMES_LITE_MODE=embedded_spike for local development. Never commit a real key.
# Prefer SILICONFLOW_API_KEY_FILE for a mounted secret in deployments; the API
# process sends only verified fact projections to the allow-listed endpoint.
# See docs/byok.md (or `make configure-siliconflow-key`) for hidden-input setup.
# Docker Compose reads its key from secrets/siliconflow_api_key, not this file.
SILICONFLOW_API_KEY=
SILICONFLOW_API_KEY_FILE=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_MAX_TOKENS=800
SILICONFLOW_MAX_RESPONSE_BYTES=262144
LLM_TIMEOUT_SECONDS=8
# Keep the default 2500ms for the local mock; live SiliconFlow deployments
# should raise this to 8000ms (the Compose override does so automatically).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:54572,http://127.0.0.1:54572
LOG_LEVEL=INFO
RUNTIME_PROFILE=template
HERMES_LITE_MODE=off
# HERMES_LITE_ENDPOINT remains reserved for a future isolated sidecar. The
# direct SiliconFlow adapter does not accept a user-supplied endpoint.
HERMES_LITE_ENDPOINT=
HERMES_LITE_MAX_TOKENS=800
HERMES_LITE_TIMEOUT_MS=2500
MAX_REQUEST_BYTES=32768
MAX_EVENT_BYTES=16384
MAX_RESPONSE_BYTES=262144
MAX_SSE_CONNECTIONS=100
MAX_INFLIGHT_REQUESTS=32
QUEUE_MAX_DEPTH=64
SHUTDOWN_DRAIN_MS=10000
EGRESS_ALLOWLIST=site.web.api.espn.com,cdn.espn.com
# Shared-password access control. Keep AUTH_REQUIRED=false only for local
# fixture development; public deployments should use docker-compose.auth.yml
# with `make configure-app-password` and the mounted secret file.
AUTH_REQUIRED=false
APP_PASSWORD=
APP_PASSWORD_FILE=
AUTH_COOKIE_NAME=nba_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=86400
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCKOUT_SECONDS=60
